# Puerto del server Express
PORT=4000

# Origin del landing que puede llamar a este backend (CORS allowlist, CSV).
# Durante dev: http://localhost:5173
# En prod: https://nexo-v3-landing.vercel.app (o el dominio final)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase staging (project `icesuzwyfhcpaukserqt` = nexo-portal-test).
# El service_role_key es el que persiste leads y genera magic links.
SUPABASE_URL=https://icesuzwyfhcpaukserqt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (misma API key que usa prod). `RESEND_FROM` debe estar en el dominio
# verificado de Previnca.
RESEND_API_KEY=
RESEND_FROM=Previnca Nexo <onboarding@resend.dev>

# URL base del portal v3 donde redirige el magic link tras verificar.
# Durante dev: http://localhost:5174
PORTAL_URL=http://localhost:5174

# Salesforce — integración /leads. Mientras SF_ENABLED sea `false` el server
# arma el payload que mandaría pero NO hace el POST a SF: devuelve un sfLeadId
# mock (prefijo `MOCK-`) y loguea el payload en consola. Cuando esté todo
# listo para producción, cambiar a `true` + completar las 4 credenciales.
SF_ENABLED=false
SF_TOKEN_URL=
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
