# ─────────────────────────── Dominios ───────────────────────────
# TODO el routing de dominio del backend sale de acá. Para migrar a producción
# alcanza con cambiar estas 3 URLs + CORS_ORIGINS. Tres topologías típicas:
#
#  a) Dev local standalone (lo que ves abajo)
#       LANDING_URL=http://localhost:5173
#       PORTAL_URL=http://localhost:5174
#       CORS_ORIGINS=http://localhost:5173,http://localhost:5174
#
#  b) Deploy unificado (landing y portal en un dominio, portal bajo /app)
#       LANDING_URL=https://nexo.previncasalud.com.ar
#       PORTAL_URL=https://nexo.previncasalud.com.ar/app
#       CORS_ORIGINS=https://nexo.previncasalud.com.ar
#
#  c) Deploy split (landing y portal en dominios distintos)
#       LANDING_URL=https://nexo.previncasalud.com.ar
#       PORTAL_URL=https://app.previncasalud.com.ar
#       CORS_ORIGINS=https://nexo.previncasalud.com.ar,https://app.previncasalud.com.ar

# URL del landing público — se usa en el email de referidos (/catalogo).
LANDING_URL=http://localhost:5173

# URL del portal privado — se usa en el redirectTo del magic link.
PORTAL_URL=http://localhost:5174

# Origins permitidos por CORS (CSV). Deben coincidir con LANDING_URL y PORTAL_URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# URL pública del logo del email (hospedado en el front). Si cambia el dominio
# del landing, actualizar.
EMAIL_LOGO_URL=http://localhost:5173/logo-nexo-email.png

# ─────────────────────────── Servidor ───────────────────────────
PORT=4000

# ─────────────────────────── Supabase ───────────────────────────
# El service_role_key persiste leads y genera magic links. NUNCA se expone al
# browser (el browser usa el anon key via VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=https://icesuzwyfhcpaukserqt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────── Resend ───────────────────────────
# RESEND_FROM debe estar verificado en el dominio de Previnca.
RESEND_API_KEY=
RESEND_FROM=Nexo <onboarding@resend.dev>

# ─────────────────────────── Salesforce ───────────────────────────
# Mientras SF_ENABLED=false el server arma el payload pero no hace el POST:
# devuelve sfLeadId mock (prefijo MOCK-) y loguea en consola. Para producción
# poner true + completar las 4 credenciales.
SF_ENABLED=false
SF_TOKEN_URL=
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ─────────────────────────── MercadoPago ───────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
