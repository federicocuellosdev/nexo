# ─────────────────────────── Dominios ───────────────────────────
# TODO el routing de dominio del portal sale de acá. Para migrar a producción
# alcanza con cambiar estas 2 URLs. Tres topologías típicas:
#
#  a) Dev local standalone
#       VITE_LANDING_URL=http://localhost:5173
#       VITE_API_URL=http://localhost:4000
#
#  b) Deploy unificado (landing y portal en un dominio, portal bajo /app)
#       VITE_LANDING_URL=https://nexo.previncasalud.com.ar
#       VITE_API_URL=https://api.previncasalud.com.ar
#
#  c) Deploy split (landing y portal en dominios distintos)
#       VITE_LANDING_URL=https://nexo.previncasalud.com.ar
#       VITE_API_URL=https://api.previncasalud.com.ar

# URL del landing público — se usa en los links "Ver catálogo" desde el portal
# y en la URL de atribución de afiliados (/catalogo?ref=...).
VITE_LANDING_URL=http://localhost:5173

# URL del backend (apps/api) — todas las llamadas del portal van acá.
VITE_API_URL=http://localhost:4000

# ─────────────────────────── Supabase ───────────────────────────
# El ANON key es público y se expone al cliente — RLS limita qué se puede
# leer/escribir. Debe ser el MISMO proyecto que usa apps/api para que el
# token del magic link sea válido acá cuando llega al callback.
VITE_SUPABASE_URL=https://icesuzwyfhcpaukserqt.supabase.co
VITE_SUPABASE_ANON_KEY=
