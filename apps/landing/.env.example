# ─────────────────────────── Dominios ───────────────────────────
# TODO el routing de dominio del landing sale de acá. Para migrar a producción
# alcanza con cambiar estas 2 URLs. Tres topologías típicas:
#
#  a) Dev local standalone
#       VITE_PORTAL_URL=http://localhost:5174
#       VITE_API_URL=http://localhost:4000
#
#  b) Deploy unificado (landing y portal en un dominio, portal bajo /app)
#       VITE_PORTAL_URL=https://nexo.previncasalud.com.ar/app
#       VITE_API_URL=https://api.previncasalud.com.ar
#
#  c) Deploy split (landing y portal en dominios distintos)
#       VITE_PORTAL_URL=https://app.previncasalud.com.ar
#       VITE_API_URL=https://api.previncasalud.com.ar

# URL del portal privado — se usa en los links "Ingresar" / "Ver mi portal"
# desde el landing. Debe incluir el subpath /app si el deploy es unificado.
VITE_PORTAL_URL=http://localhost:5174

# URL del backend (apps/api) — todas las llamadas del landing van acá
# (crear lead, pedir magic link, etc.).
VITE_API_URL=http://localhost:4000
